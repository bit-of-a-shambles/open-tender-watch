<div class="animate-fade-up">
  <%# Header %>
  <header class="py-8 border-b border-white/10">
    <div class="flex items-center gap-4 mb-3">
      <%= link_to entities_path, class: "font-mono text-[11px] tracking-[2px] text-white/30 hover:text-white/60 transition-colors" do %>
        ← <%= t("entities.index.title") %>
      <% end %>
      <% if @entity.is_public_body? %>
        <span class="font-mono text-[10px] text-[#c8a84e] bg-[#c8a84e12] px-2 py-0.5 rounded border border-[#c8a84e33]">
          <%= t("entities.show.public_body") %>
        </span>
      <% else %>
        <span class="font-mono text-[10px] text-white/40 bg-white/[0.04] px-2 py-0.5 rounded border border-white/[0.08]">
          <%= t("entities.show.company") %>
        </span>
      <% end %>
    </div>
    <h1 class="font-['Space_Grotesk'] text-2xl font-bold text-[#e8e0d4] leading-snug mb-2">
      <%= @entity.name %>
    </h1>
    <div class="font-mono text-[11px] text-white/25">
      <%= t("entities.show.nif") %> <%= @entity.tax_identifier %>
      · <%= @entity.country_code %>
    </div>
    <div class="flex items-center gap-2 mt-3">
      <%= link_to t("exports.download_csv"), entity_path(@entity, format: :csv),
          class: "border border-white/10 text-white/30 font-mono text-[10px] tracking-widest px-3 py-1.5 rounded hover:border-[#c8a84e44] hover:text-[#c8a84e] transition-all",
          data: { turbo: false } %>
      <%= link_to t("exports.download_json"), entity_path(@entity, format: :json),
          class: "border border-white/10 text-white/30 font-mono text-[10px] tracking-widest px-3 py-1.5 rounded hover:border-[#c8a84e44] hover:text-[#c8a84e] transition-all",
          data: { turbo: false } %>
    </div>
  </header>

  <% if @flag_stats.any? %>
    <% sorted_stats = @flag_stats.sort_by { |s| c = s.flag_type.split("_").first; [c[0], c[1..].to_i, s.flag_type] } %>
    <div class="border border-white/[0.08] rounded-lg overflow-hidden mt-6">
      <div class="px-4 py-3 bg-white/[0.02] border-b border-white/[0.06]">
        <span class="font-mono text-[10px] tracking-[2px] text-white/35 uppercase"><%= t("entities.show.risk_flags") %></span>
      </div>
      <% sorted_stats.each do |stat| %>
        <% severity = flag_type_severity(stat.flag_type) %>
        <% s = severity_styles(severity) %>
        <% code = stat.flag_type.split("_").first.downcase %>
        <% desc = t("dashboard.methodology.flags.#{code}_desc", default: "") %>
        <% active_flag = @flag_filter == stat.flag_type %>
        <div class="border-b border-white/[0.04] last:border-0 <%= active_flag ? 'bg-white/[0.04]' : '' %>">
          <%= link_to entity_path(@entity, flag_type: stat.flag_type),
              data: { turbo_frame: "entity-contracts" },
              class: "block px-4 py-3 hover:bg-white/[0.03] transition-colors cursor-pointer" do %>
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
              <span class="font-mono text-[11px] <%= s[:text] %> font-medium flex-1 min-w-0">
                <%= flag_type_label(stat.flag_type) %>
              </span>
              <span class="font-['Space_Grotesk'] text-sm font-bold text-[#e8e0d4]">
                <%= number_to_currency(stat.total_exposure, unit: "€", delimiter: ",", separator: ".", format: "%u%n", precision: 0) %>
              </span>
              <span class="font-mono text-[10px] text-white/35">
                <%= number_with_delimiter(stat.contract_count) %> <%= t("entities.show.contracts_short") %>
              </span>
            </div>
            <% if desc.present? %>
              <div class="font-mono text-[10px] text-white/30 mt-1.5 leading-relaxed">
                <%= desc %>
              </div>
            <% end %>
          <% end %>
          <% if stat.breakdown.any? %>
            <div class="px-4 pb-2.5 -mt-1 pl-8 space-y-1">
              <% stat.breakdown.each do |b| %>
                <% bs = severity_styles(b[:severity]) %>
                <div class="flex items-center gap-x-3 font-mono text-[10px]">
                  <span class="<%= bs[:text] %> tracking-wide px-1.5 py-0.5 rounded border <%= bs[:bg] %> <%= bs[:border] %>">
                    <%= t("dashboard.insights.severity_#{b[:severity]}") %>
                  </span>
                  <span class="text-[#e8e0d4] flex-1">
                    <%= number_to_currency(b[:total_exposure], unit: "€", delimiter: ",", separator: ".", format: "%u%n", precision: 0) %>
                  </span>
                  <span class="text-white/35">
                    <%= number_with_delimiter(b[:contract_count]) %> <%= t("entities.show.contracts_short") %>
                  </span>
                </div>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </div>
  <% end %>

  <div class="flex flex-col-reverse lg:grid lg:grid-cols-[1fr_280px] gap-6 mt-6">

    <%# Contract list %>
    <div>
      <%= turbo_frame_tag "entity-contracts", data: { controller: "entity-contracts" } do %>
        <%# Flag filter chips %>
        <% if @flag_types.any? %>
          <div class="flex flex-wrap items-center gap-2 mb-4">
            <span class="font-mono text-[10px] tracking-[2px] text-white/35 uppercase shrink-0"><%= t("entities.show.filter_by_flag") %>:</span>
            <%= link_to entity_path(@entity, sort: @sort_col, dir: @sort_dir, date_from: @date_from, date_to: @date_to, page: 1),
                  class: "font-mono text-[10px] px-2.5 py-1 rounded border transition-all #{@flag_filter.nil? ? 'border-white/30 text-white/60 bg-white/[0.06]' : 'border-white/10 text-white/30 hover:text-white/60 hover:border-white/20'}" do %>
              <%= t("entities.show.filter_all_flags") %>
            <% end %>
            <% @flag_types.each do |ft| %>
              <% active_ft = @flag_filter == ft %>
              <% chip_color = active_ft ? "border-[#c8a84e66] text-[#c8a84e] bg-[#c8a84e0d]" : "border-white/10 text-white/30 hover:text-white/60 hover:border-white/20" %>
              <%= link_to entity_path(@entity, sort: @sort_col, dir: @sort_dir, flag_type: ft, date_from: @date_from, date_to: @date_to, page: 1),
                    class: "font-mono text-[10px] px-2.5 py-1 rounded border transition-all #{chip_color}" do %>
                <%= flag_type_label(ft) %>
              <% end %>
            <% end %>
          </div>
        <% end %>

        <%# Date filter %>
        <%= form_with url: entity_path(@entity), method: :get, class: "flex items-center gap-2 mb-3" do |f| %>
          <%= hidden_field_tag :sort, @sort_col %>
          <%= hidden_field_tag :dir, @sort_dir %>
          <%= hidden_field_tag :flag_type, @flag_filter %>
          <label class="font-mono text-[10px] text-white/35 shrink-0"><%= t("contracts.index.date_from") %></label>
          <%= f.date_field :date_from, value: @date_from,
              class: "bg-white/[0.04] border border-white/[0.1] rounded px-2 py-1.5 font-mono text-xs text-[#e8e0d4] focus:outline-none focus:border-[#c8a84e55] transition-all" %>
          <label class="font-mono text-[10px] text-white/35 shrink-0"><%= t("contracts.index.date_to") %></label>
          <%= f.date_field :date_to, value: @date_to,
              class: "bg-white/[0.04] border border-white/[0.1] rounded px-2 py-1.5 font-mono text-xs text-[#e8e0d4] focus:outline-none focus:border-[#c8a84e55] transition-all" %>
          <%= f.submit t("contracts.index.filter"),
              class: "bg-[#c8a84e1a] border border-[#c8a84e44] text-[#c8a84e] font-mono text-[10px] tracking-widest px-3 py-1.5 rounded hover:bg-[#c8a84e33] transition-all cursor-pointer" %>
          <% if @date_from.present? || @date_to.present? %>
            <%= link_to t("contracts.index.clear"), entity_path(@entity, sort: @sort_col, dir: @sort_dir, flag_type: @flag_filter),
                class: "font-mono text-[10px] text-white/30 hover:text-white/50 transition-all" %>
          <% end %>
        <% end %>

        <%# Pagination info%>
        <% if @total_pages > 1 || @total > 0 %>
          <p class="font-mono text-[11px] text-white/30 mb-3">
            <%= t("contracts.index.pagination.info", page: @page, total_pages: [@total_pages, 1].max, total: number_with_delimiter(@total)) %>
          </p>
        <% end %>

        <%# Table %>
        <div class="border border-white/[0.08] rounded-lg overflow-hidden">
          <%# Sortable header row %>
          <div class="hidden sm:grid grid-cols-[1fr_160px_140px_100px_90px] bg-white/[0.03] px-4 py-3 border-b border-white/[0.08] font-mono text-[10px] tracking-[2px] text-white/35 uppercase">
            <%= sort_header_link t("contracts.index.col_contract"), column: "object", sort_col: @sort_col, sort_dir: @sort_dir,
                  url: entity_path(@entity, sort: "object", dir: next_sort_dir("object", @sort_col, @sort_dir), flag_type: @flag_filter, date_from: @date_from, date_to: @date_to, page: 1) %>
            <span><%= t("contracts.show.winners.heading", count: 1) %></span>
            <span><%= t("contracts.index.col_procedure") %></span>
            <%= sort_header_link t("contracts.index.col_price"), column: "base_price", sort_col: @sort_col, sort_dir: @sort_dir, align_right: true,
                  url: entity_path(@entity, sort: "base_price", dir: next_sort_dir("base_price", @sort_col, @sort_dir), flag_type: @flag_filter, date_from: @date_from, date_to: @date_to, page: 1) %>
            <%= sort_header_link t("contracts.index.col_date"), column: "celebration_date", sort_col: @sort_col, sort_dir: @sort_dir, align_right: true,
                  url: entity_path(@entity, sort: "celebration_date", dir: next_sort_dir("celebration_date", @sort_col, @sort_dir), flag_type: @flag_filter, date_from: @date_from, date_to: @date_to, page: 1) %>
          </div>

          <% if @contracts.empty? %>
            <div class="px-5 py-12 text-center font-mono text-sm text-white/25">
              <%= t("contracts.index.empty") %>
            </div>
          <% else %>
            <% @contracts.each do |contract| %>
              <%= link_to contract_path(contract), class: "flex flex-col sm:grid sm:grid-cols-[1fr_160px_140px_100px_90px] px-4 py-3 border-b border-white/[0.04] last:border-0 hover:bg-white/[0.03] transition-colors group sm:items-start gap-1 sm:gap-0", data: { turbo_frame: "_top" } do %>
                <div class="pr-0 sm:pr-4">
                  <div class="text-sm text-[#e8e0d4] group-hover:text-white transition-colors line-clamp-2 leading-snug">
                    <%= contract.object %>
                  </div>
                  <div class="font-mono text-[10px] text-white/25 mt-1">
                    <%= contract.country_code %> · <%= contract.external_id %>
                  </div>
                  <% if contract.flags.any? %>
                    <div class="mt-1.5 flex flex-wrap gap-1">
                      <% contract.flags.first(2).each do |flag| %>
                        <% fs = severity_styles(flag_type_severity(flag.flag_type)) %>
                        <span class="font-mono text-[9px] tracking-wide <%= fs[:text] %> <%= fs[:bg] %> <%= fs[:border] %> px-1.5 py-0.5 rounded border">
                          <%= flag_type_label(flag.flag_type) %>
                        </span>
                      <% end %>
                      <% if contract.flags.size > 2 %>
                        <span class="font-mono text-[9px] text-white/35">+<%= contract.flags.size - 2 %></span>
                      <% end %>
                    </div>
                  <% end %>
                </div>
                <div class="hidden sm:block truncate pr-4 pt-0.5 text-sm text-white/50">
                  <%= contract.winners.first&.name&.truncate(22) || "—" %>
                </div>
                <div class="flex items-center gap-2 sm:block">
                  <% if contract.procedure_type.present? %>
                    <span class="font-mono text-[10px] text-white/40 bg-white/[0.04] px-2 py-0.5 rounded border border-white/[0.06] leading-tight inline-block sm:mt-0.5">
                      <%= contract.procedure_type.truncate(20) %>
                    </span>
                  <% end %>
                  <% if contract.base_price.present? %>
                    <span class="font-mono text-xs text-[#c8a84e] font-medium sm:hidden">
                      €<%= number_with_delimiter(contract.base_price.to_i) %>
                    </span>
                  <% end %>
                  <span class="font-mono text-[10px] text-white/30 sm:hidden">
                    <%= contract.celebration_date&.strftime("%Y-%m-%d") %>
                  </span>
                </div>
                <div class="hidden sm:block text-right font-mono text-xs text-[#c8a84e] font-medium pt-0.5">
                  <% if contract.base_price.present? %>
                    €<%= number_with_delimiter(contract.base_price.to_i) %>
                  <% else %>
                    <span class="text-white/20">—</span>
                  <% end %>
                </div>
                <div class="hidden sm:block text-right font-mono text-[11px] text-white/35 pt-0.5">
                  <%= contract.celebration_date&.strftime("%Y-%m-%d") || "—" %>
                </div>
              <% end %>
            <% end %>
          <% end %>
        </div>

        <%# Pagination %>
        <% if @total_pages > 1 %>
          <div class="flex items-center justify-end mt-4 font-mono text-xs text-white/35 gap-2">
            <% if @page > 1 %>
              <%= link_to t("contracts.index.pagination.prev"),
                    entity_path(@entity, sort: @sort_col, dir: @sort_dir, flag_type: @flag_filter, date_from: @date_from, date_to: @date_to, page: @page - 1),
                    class: "border border-white/10 px-3 py-1.5 rounded hover:border-[#c8a84e44] hover:text-[#c8a84e] transition-all" %>
            <% end %>
            <% if @page < @total_pages %>
              <%= link_to t("contracts.index.pagination.next"),
                    entity_path(@entity, sort: @sort_col, dir: @sort_dir, flag_type: @flag_filter, date_from: @date_from, date_to: @date_to, page: @page + 1),
                    class: "border border-white/10 px-3 py-1.5 rounded hover:border-[#c8a84e44] hover:text-[#c8a84e] transition-all" %>
            <% end %>
          </div>
        <% end %>
      <% end %>
    </div>

    <%# Sidebar %>
    <div class="space-y-4">

      <%# Summary stats %>
      <div class="bg-white/[0.02] border border-white/[0.06] rounded-lg p-5">
        <div class="font-mono text-[10px] tracking-[2px] text-white/35 mb-4 uppercase"><%= t("entities.show.overview") %></div>
        <div class="space-y-3">
          <div>
            <div class="font-mono text-[10px] text-white/30 mb-0.5"><%= t("entities.show.total_contracts") %></div>
            <div class="font-['Space_Grotesk'] text-2xl font-bold text-[#c8a84e]">
              <%= number_with_delimiter(@entity_contract_total) %>
            </div>
          </div>
          <% if @entity_risk_score.to_i > 0 %>
            <% risk_tier = case @entity_risk_score.to_i
               when 1..34  then "low"
               when 35..69 then "medium"
               when 70..109 then "high"
               else             "critical"
               end %>
            <% s = severity_styles(risk_tier) %>
            <div class="flex items-center justify-between pt-2 border-t border-white/[0.06]">
              <div class="font-mono text-[10px] text-white/30"><%= t("contracts.show.flags.risk_score", score: @entity_risk_score, tier: t("contracts.show.flags.risk_tier_#{risk_tier}")) %></div>
              <span class="w-2 h-2 rounded-full <%= s[:dot] %>"></span>
            </div>
          <% end %>
        </div>
      </div>


      <%# Benford distribution data — rendered client-side into a chart by a future JS controller.
          The data-benford-* attributes carry everything needed: observed digit counts, Benford
          expected percentages, chi-square stat, and sample size. %>
      <% if @benford_analysis %>
        <% benford_expected = (1..9).each_with_object({}) { |d, h| h[d.to_s] = (Math.log10(1.0 + 1.0 / d) * 100).round(2) } %>
        <div id="benford-chart-placeholder"
             class="bg-white/[0.02] border border-white/[0.06] rounded-lg p-5"
             data-controller="benford-chart"
             data-benford-chart-observed-value="<%= @benford_analysis.digit_distribution.to_json %>"
             data-benford-chart-expected-value="<%= benford_expected.to_json %>"
             data-benford-chart-chi2-value="<%= @benford_analysis.chi_square %>"
             data-benford-chart-sample-size-value="<%= @benford_analysis.sample_size %>"
             data-benford-chart-flagged-value="<%= @benford_analysis.flagged %>">
          <div class="font-mono text-[10px] tracking-[2px] text-white/35 mb-3 uppercase">
            <%= t("entities.show.benford_distribution") %>
          </div>
          <div class="font-mono text-[10px] text-white/30 mb-1">
            n = <%= number_with_delimiter(@benford_analysis.sample_size) %> <%= t("entities.show.contracts_short") %>
            · χ² = <%= @benford_analysis.chi_square %>
          </div>
          <%# Inline bar chart — digits 1–9, observed vs expected %>
          <div class="mt-3 space-y-1">
            <% (1..9).each do |d| %>
              <% obs_count = @benford_analysis.digit_distribution[d.to_s].to_i %>
              <% obs_pct   = @benford_analysis.sample_size > 0 ? (obs_count.to_f / @benford_analysis.sample_size * 100).round(1) : 0 %>
              <% exp_pct   = benford_expected[d.to_s] %>
              <% bar_color = @benford_analysis.flagged && (obs_pct - exp_pct).abs > 5 ? "bg-[#ff4444]" : "bg-[#c8a84e]" %>
              <div class="flex items-center gap-2">
                <span class="font-mono text-[10px] text-white/40 w-3 shrink-0"><%= d %></span>
                <div class="flex-1 relative h-3 bg-white/[0.05] rounded-sm overflow-hidden">
                  <div class="absolute inset-y-0 left-0 <%= bar_color %> opacity-60 rounded-sm transition-all"
                       style="width: <%= [obs_pct, 100].min %>%"></div>
                  <div class="absolute inset-y-0 left-0 border-r border-white/40"
                       style="width: <%= [exp_pct, 100].min %>%"></div>
                </div>
                <span class="font-mono text-[9px] text-white/30 w-8 text-right shrink-0"><%= obs_pct %>%</span>
              </div>
            <% end %>
          </div>
          <div class="mt-2 flex items-center gap-3 font-mono text-[9px] text-white/30">
            <span class="flex items-center gap-1"><span class="inline-block w-3 h-2 bg-[#c8a84e] opacity-60 rounded-sm"></span> <%= t("entities.show.benford_observed") %></span>
            <span class="flex items-center gap-1"><span class="inline-block w-px h-3 bg-white/40"></span> <%= t("entities.show.benford_expected") %></span>
          </div>
        </div>
      <% end %>

    </div>
  </div>
</div>
