<% default_limit = Graph::EntityNetworkService::DEFAULT_NEIGHBOR_LIMIT %>
<% include_individuals_default = local_assigns.fetch(:include_individuals_default, false) %>
<% include_individuals_default_value = include_individuals_default ? "true" : "false" %>

<section class="mt-6 bg-white/2 border border-white/6 rounded-lg p-4 sm:p-5"
         data-controller="entity-network-graph"
         data-entity-network-graph-endpoint-value="<%= "#{entity_network_graph_path(entity_id: entity.id)}.json" %>"
         data-entity-network-graph-default-limit-value="<%= default_limit %>"
         data-entity-network-graph-default-include-individuals-value="<%= include_individuals_default_value %>"
         data-entity-network-graph-public-body-label-value="<%= t('graph.legend_public_body') %>"
         data-entity-network-graph-company-label-value="<%= t('graph.legend_company') %>"
         data-entity-network-graph-individual-label-value="<%= t('graph.legend_individual') %>"
         data-entity-network-graph-focus-label-value="<%= t('graph.focus_label') %>"
         data-entity-network-graph-edge-from-focus-label-value="<%= t('graph.edge_from_focus') %>"
         data-entity-network-graph-edge-to-focus-label-value="<%= t('graph.edge_to_focus') %>"
         data-entity-network-graph-edge-bidirectional-label-value="<%= t('graph.edge_bidirectional') %>"
         data-entity-network-graph-edge-peer-award-label-value="<%= t('graph.edge_peer_award') %>"
         data-entity-network-graph-edge-entity-role-label-value="<%= t('graph.edge_entity_role') %>"
         data-entity-network-graph-yes-label-value="<%= t('graph.yes') %>"
         data-entity-network-graph-no-label-value="<%= t('graph.no') %>"
         data-entity-network-graph-error-label-value="<%= t('graph.error') %>">
  <div class="flex items-start justify-between gap-3 flex-wrap">
    <div>
      <h2 class="font-['Space_Grotesk'] text-base font-semibold text-[#e8e0d4]"><%= t("graph.heading") %></h2>
      <p class="font-mono text-[10px] text-white/35 mt-1"><%= t("graph.subtitle") %></p>
    </div>
    <p class="font-mono text-[10px] text-[#c8a84e] bg-[#c8a84e12] border border-[#c8a84e33] px-2 py-1 rounded">
      <%= journalist_access? ? t("graph.privacy_notice_authenticated") : t("graph.privacy_notice_public") %>
    </p>
  </div>

  <form class="flex flex-col sm:flex-row sm:items-center gap-2 mt-4 flex-wrap" data-action="submit->entity-network-graph#applyFilters">
    <label class="font-mono text-[10px] text-white/35"><%= t("graph.filter_from") %></label>
    <input type="date"
           data-entity-network-graph-target="dateFrom"
          class="w-full sm:w-auto bg-white/4 border border-white/10 rounded px-2 py-1.5 font-mono text-xs text-[#e8e0d4] focus:outline-none focus:border-[#c8a84e55] transition-all">

    <label class="font-mono text-[10px] text-white/35"><%= t("graph.filter_to") %></label>
    <input type="date"
           data-entity-network-graph-target="dateTo"
          class="w-full sm:w-auto bg-white/4 border border-white/10 rounded px-2 py-1.5 font-mono text-xs text-[#e8e0d4] focus:outline-none focus:border-[#c8a84e55] transition-all">

    <label class="font-mono text-[10px] text-white/35"><%= t("graph.limit") %></label>
    <input type="number"
           min="1"
           max="200"
           value="<%= default_limit %>"
           data-entity-network-graph-target="limit"
          class="w-full sm:w-20 bg-white/4 border border-white/10 rounded px-2 py-1.5 font-mono text-xs text-[#e8e0d4] focus:outline-none focus:border-[#c8a84e55] transition-all">

    <button type="submit"
            class="w-full sm:w-auto bg-[#c8a84e1a] border border-[#c8a84e44] text-[#c8a84e] font-mono text-[10px] tracking-widest px-3 py-1.5 rounded hover:bg-[#c8a84e33] transition-all cursor-pointer">
      <%= t("graph.apply") %>
    </button>

    <% if journalist_access? %>
      <label class="flex w-full sm:w-auto items-center gap-1.5 px-2 py-1 rounded border border-white/10 bg-white/3">
        <input type="checkbox"
               data-entity-network-graph-target="includeIndividuals"
               class="accent-[#c8a84e]"
               <%= "checked" if include_individuals_default %>>
        <span class="font-mono text-[10px] text-white/55"><%= t("graph.include_individuals") %></span>
      </label>
    <% end %>

    <button type="button"
            data-action="click->entity-network-graph#resetFilters"
            class="w-full sm:w-auto border border-white/10 text-white/30 font-mono text-[10px] tracking-widest px-3 py-1.5 rounded hover:text-white/60 hover:border-white/20 transition-all cursor-pointer">
      <%= t("graph.reset") %>
    </button>
  </form>

  <div class="mt-4 grid lg:grid-cols-[1fr_250px] gap-4">
    <div class="relative border border-white/8 rounded-lg overflow-hidden bg-[#0d0f14] min-h-[340px] sm:min-h-[430px]">
      <div data-entity-network-graph-target="canvas" class="h-[340px] sm:h-[430px] w-full"></div>

      <div data-entity-network-graph-target="loading"
           class="absolute inset-0 flex items-center justify-center font-mono text-xs text-white/35 bg-[#0d0f14]/70">
        <%= t("graph.loading") %>
      </div>

      <div data-entity-network-graph-target="error"
           class="hidden absolute inset-0 items-center justify-center text-center px-4 font-mono text-xs text-[#ff4444] bg-[#0d0f14]/80">
      </div>

      <div data-entity-network-graph-target="empty"
           class="hidden absolute inset-0 items-center justify-center text-center px-4 font-mono text-xs text-white/35 bg-[#0d0f14]/80">
        <%= t("graph.empty") %>
      </div>
    </div>

    <aside class="bg-white/2 border border-white/6 rounded-lg p-4 space-y-4">
      <div>
        <h3 class="font-mono text-[10px] tracking-[2px] text-white/35 uppercase mb-2"><%= t("graph.summary_heading") %></h3>
        <div class="space-y-1.5 font-mono text-[11px] text-white/55">
          <div class="flex items-center justify-between">
            <span><%= t("graph.summary_nodes") %></span>
            <span class="text-[#e8e0d4]" data-entity-network-graph-target="nodesCount">0</span>
          </div>
          <div class="flex items-center justify-between">
            <span><%= t("graph.summary_edges") %></span>
            <span class="text-[#e8e0d4]" data-entity-network-graph-target="edgesCount">0</span>
          </div>
          <div class="flex items-center justify-between">
            <span><%= t("graph.summary_truncated") %></span>
            <span class="text-[#e8e0d4]" data-entity-network-graph-target="truncated">-</span>
          </div>
        </div>
      </div>

      <div class="pt-3 border-t border-white/6">
        <h3 class="font-mono text-[10px] tracking-[2px] text-white/35 uppercase mb-2"><%= t("graph.selection_heading") %></h3>
        <div class="font-mono text-[11px] text-[#e8e0d4] mb-2" data-entity-network-graph-target="selectedName">-</div>
        <div class="space-y-1.5 font-mono text-[10px] text-white/45">
          <div class="flex items-center justify-between">
            <span><%= t("graph.selection_type") %></span>
            <span class="text-white/70" data-entity-network-graph-target="selectedType">-</span>
          </div>
          <div class="flex items-center justify-between">
            <span><%= t("graph.selection_contracts") %></span>
            <span class="text-white/70" data-entity-network-graph-target="selectedContracts">-</span>
          </div>
          <div class="flex items-center justify-between">
            <span><%= t("graph.selection_value") %></span>
            <span class="text-white/70" data-entity-network-graph-target="selectedValue">-</span>
          </div>
          <div class="flex items-center justify-between">
            <span><%= t("graph.selection_relation") %></span>
            <span class="text-white/70" data-entity-network-graph-target="selectedRelation">-</span>
          </div>
          <div class="flex items-center justify-between">
            <span><%= t("graph.selection_outgoing") %></span>
            <span class="text-white/70" data-entity-network-graph-target="selectedOutgoing">-</span>
          </div>
          <div class="flex items-center justify-between">
            <span><%= t("graph.selection_incoming") %></span>
            <span class="text-white/70" data-entity-network-graph-target="selectedIncoming">-</span>
          </div>
          <div class="flex items-center justify-between">
            <span><%= t("graph.selection_entities") %></span>
            <span class="text-white/70 text-right max-w-[130px] truncate" data-entity-network-graph-target="selectedEntities">-</span>
          </div>
          <div class="flex items-center justify-between">
            <span><%= t("graph.selection_flagged") %></span>
            <span class="text-white/70" data-entity-network-graph-target="selectedFlagged">-</span>
          </div>
          <div class="flex items-center justify-between">
            <span><%= t("graph.selection_risk_score") %></span>
            <span class="text-white/70" data-entity-network-graph-target="selectedRiskScore">-</span>
          </div>
        </div>
      </div>
    </aside>
  </div>

  <div class="mt-3 pt-3 border-t border-white/6 flex items-center gap-4 flex-wrap">
    <span class="font-mono text-[9px] tracking-[2px] text-white/35 uppercase"><%= t("graph.legend_heading") %></span>
    <span class="font-mono text-[10px] text-white/55 flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 rounded-full bg-[#c8a84e]"></span><%= t("graph.legend_focus") %></span>
    <span class="font-mono text-[10px] text-white/55 flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 rounded-full bg-[#44b7ff]"></span><%= t("graph.legend_public_body") %></span>
    <span class="font-mono text-[10px] text-white/55 flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 rounded-full bg-[#ff9f5b]"></span><%= t("graph.legend_company") %></span>
    <span class="font-mono text-[10px] text-white/55 flex items-center gap-1.5"><span class="inline-block w-2.5 h-2.5 rounded-full bg-[#a6b0bf]"></span><%= t("graph.legend_individual") %></span>
  </div>
</section>
