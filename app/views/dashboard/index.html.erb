<div data-controller="dashboard" class="animate-fade-up">
  <%# Header %>
  <header class="py-6 sm:py-8 border-b border-white/10">
    <div class="flex items-center gap-3 mb-1">
      <div class="w-2.5 h-2.5 rounded-full bg-[#ff4444] shadow-[0_0_12px_rgba(255,68,68,0.5)] animate-pulse-slow"></div>
      <span class="font-mono text-[11px] tracking-[3px] text-white/40 font-semibold uppercase"><%= t("app.live") %></span>
    </div>
    <h1 class="font-['Space_Grotesk'] text-2xl sm:text-3xl font-bold tracking-tight bg-linear-to-r from-[#e8e0d4] to-[#c8a84e] bg-clip-text text-transparent mb-1">
      <%= t("app.name") %>
    </h1>
    <p class="text-white/35 text-sm">
      <%= t("app.tagline") %>
    </p>
  </header>

  <%# Stats bar %>
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-px my-6 bg-white/5 rounded-lg overflow-hidden">
    <% @stats.each do |stat| %>
      <div class="p-4 text-center bg-black/20">
        <div class="font-['Space_Grotesk'] text-2xl font-bold <%= stat[:color] %>">
          <%= stat[:value] %>
        </div>
        <div class="font-mono text-[10px] tracking-[2px] text-white/35 mt-0.5">
          <%= stat[:label] %>
        </div>
      </div>
    <% end %>
  </div>

  <%# Tabs %>
  <div class="flex overflow-x-auto border-b border-white/10 mb-6 -mx-3 px-3 sm:mx-0 sm:px-0">
    <button data-dashboard-target="tab" data-tab="insights" data-action="click->dashboard#switchTab"
            class="font-mono text-xs tracking-widest uppercase bg-none border-none px-4 py-3 cursor-pointer transition-all font-semibold text-[#c8a84e] border-b-2 border-[#c8a84e] whitespace-nowrap shrink-0">
      <%= t("dashboard.tabs.insights") %> <%= @insights_count %>
    </button>
    <button data-dashboard-target="tab" data-tab="cruzamentos" data-action="click->dashboard#switchTab"
            class="font-mono text-xs tracking-widest uppercase bg-none border-none px-4 py-3 cursor-pointer transition-all font-semibold text-white/30 border-b-2 border-transparent whitespace-nowrap shrink-0">
      <%= t("dashboard.tabs.crossings") %>
    </button>
    <button data-dashboard-target="tab" data-tab="fontes" data-action="click->dashboard#switchTab"
            class="font-mono text-xs tracking-widest uppercase bg-none border-none px-4 py-3 cursor-pointer transition-all font-semibold text-white/30 border-b-2 border-transparent whitespace-nowrap shrink-0">
      <%= t("dashboard.tabs.sources") %>
    </button>
    <button data-dashboard-target="tab" data-tab="metodologia" data-action="click->dashboard#switchTab"
            class="font-mono text-xs tracking-widest uppercase bg-none border-none px-4 py-3 cursor-pointer transition-all font-semibold text-white/30 border-b-2 border-transparent whitespace-nowrap shrink-0">
      <%= t("dashboard.tabs.methodology") %>
    </button>
  </div>

  <%# Insights Pane %>
  <div data-dashboard-target="pane" data-pane="insights" class="space-y-2">
    <%# Exposure banner %>
    <div class="bg-linear-to-br from-[#c8a84e14] to-[#ff44440f] border border-[#c8a84e26] border-l-4 border-l-[#c8a84e] rounded-lg p-4 sm:p-7 mb-6">
      <div class="font-mono text-[10px] tracking-[3px] text-[#c8a84e] mb-1">
        <%= t("dashboard.exposure.label") %>
      </div>
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-baseline gap-3">
        <span class="font-['Space_Grotesk'] text-2xl sm:text-5xl font-bold text-[#e8e0d4] tracking-tight sm:tracking-tighter break-words">
          <%= number_to_currency(@flagged_total_exposure || 0, unit: "€", delimiter: ",", separator: ".", format: "%u%n", precision: 2) %>
        </span>
        <div class="font-mono text-sm sm:text-right">
          <div class="text-white/50"><%= t("dashboard.exposure.contracts", count: @flagged_contract_count) %></div>
          <div class="text-white/35"><%= t("dashboard.exposure.companies", count: @flagged_companies_count) %></div>
          <div class="text-white/35"><%= t("dashboard.exposure.public_entities", count: @flagged_public_entities_count) %></div>
        </div>
      </div>
    </div>

    <%# Severity filter %>
    <div class="flex flex-wrap items-center gap-2 mb-5">
      <span class="font-mono text-[10px] tracking-[2px] text-white/35 uppercase mr-1"><%= t("dashboard.severity_filter.all") %>:</span>
      <% [nil, "high", "medium", "low"].each do |sev| %>
        <% label  = sev ? t("dashboard.severity_filter.#{sev}") : t("dashboard.severity_filter.all") %>
        <% active = @severity_filter == sev %>
        <% color  = sev == "high"   ? "border-[#ff444466] text-[#ff4444] #{active ? 'bg-[#ff44440d]' : 'bg-transparent hover:bg-[#ff44440d]'}" :
                    sev == "medium" ? "border-[#ff884466] text-[#ff8844] #{active ? 'bg-[#ff88440d]' : 'bg-transparent hover:bg-[#ff88440d]'}" :
                    sev == "low"    ? "border-[#c8a84e66] text-[#c8a84e] #{active ? 'bg-[#c8a84e0d]' : 'bg-transparent hover:bg-[#c8a84e0d]'}" :
                                      "border-white/20 text-white/50 #{active ? 'bg-white/[0.06]' : 'bg-transparent hover:bg-white/[0.04]'}" %>
        <%= link_to label,
              dashboard_index_path(severity: sev, entity_sort: @entity_sort, entity_flag_type: @entity_flag_type, entity_page: 1),
              class: "font-mono text-[10px] tracking-[2px] uppercase px-3 py-1.5 rounded border transition-colors #{color} #{active ? 'font-bold' : ''}" %>
      <% end %>
    </div>

    <%# Per-flag-type insight cards %>
    <% if @flags_by_type.any? %>
      <div class="grid grid-cols-1 sm:grid-cols-2 gap-2 mb-6">
        <% @flags_by_type.each do |flag_type, count| %>
          <% sev = @flag_type_severities&.fetch(flag_type, nil) || flag_type_severity(flag_type) %>
          <% sev_styles = severity_styles(sev) %>
          <%= link_to dashboard_index_path(entity_flag_type: flag_type, entity_sort: @entity_sort, severity: @severity_filter),
                class: "bg-white/[0.02] border border-white/[0.06] rounded-lg p-4 hover:border-[#c8a84e44] transition-colors group",
                data: { turbo_frame: "entity-table" } do %>
            <div class="flex items-start justify-between gap-2 mb-2">
              <div class="font-mono text-[10px] tracking-[1px] text-[#c8a84e] group-hover:text-[#c8a84e]">
                <%= flag_type_label(flag_type) %>
              </div>
              <span class="shrink-0 font-mono text-[9px] tracking-[1px] uppercase px-1.5 py-0.5 rounded border <%= sev_styles[:text] %> <%= sev_styles[:bg] %> <%= sev_styles[:border] %>">
                <%= t("dashboard.insights.severity_#{sev}", default: sev.upcase) %>
              </span>
            </div>
            <div class="font-['Space_Grotesk'] text-2xl font-bold text-[#e8e0d4]"><%= number_with_delimiter(count) %></div>
            <div class="font-mono text-[10px] text-white/30 mt-0.5">
              <%= t("dashboard.insights.flag_count", count: count) %>
            </div>
          <% end %>
        <% end %>
      </div>
    <% end %>

      <%# Entity table (turbo-framed for filter/pagination updates) %>
      <turbo-frame id="entity-table">
        <div class="border border-white/[0.08] rounded-lg p-3 sm:p-5 mb-6 bg-black/10">
          <div class="flex flex-wrap items-end justify-between gap-4 mb-4">
        <div>
          <h2 class="font-['Space_Grotesk'] text-lg font-semibold text-[#e8e0d4]">
            <%= t("dashboard.entity_exposure.heading") %>
          </h2>
          <p class="font-mono text-[11px] tracking-wider text-white/35 mt-1">
            <%= t("dashboard.entity_exposure.subheading") %>
          </p>
        </div>
        <%= form_with url: dashboard_index_path, method: :get, class: "flex flex-col sm:flex-row sm:flex-wrap sm:items-end gap-2.5 w-full sm:w-auto", data: { turbo_frame: "entity-table" } do |f| %>
          <%= f.hidden_field :severity, value: @severity_filter %>
          <div class="w-full sm:w-auto">
            <label class="block font-mono text-[10px] tracking-[2px] text-white/40 mb-1"><%= t("dashboard.entity_exposure.flag") %></label>
            <%= f.select :entity_flag_type,
                [[t("dashboard.entity_exposure.all_flags"), ""]] + @flag_types.map { |flag_type| [flag_type_label(flag_type), flag_type] },
                { selected: @entity_flag_type },
                class: "w-full sm:w-auto bg-black/30 border border-white/10 rounded px-2.5 py-2 font-mono text-xs text-white/75 focus:outline-hidden focus:border-[#c8a84e66]" %>
          </div>
          <div class="w-full sm:w-auto">
            <label class="block font-mono text-[10px] tracking-[2px] text-white/40 mb-1"><%= t("dashboard.entity_exposure.sort") %></label>
            <%= f.select :entity_sort,
                [
                  [t("dashboard.entity_exposure.sort_value"), "value"],
                  [t("dashboard.entity_exposure.sort_count"), "count"]
                ],
                { selected: @entity_sort },
                class: "w-full sm:w-auto bg-black/30 border border-white/10 rounded px-2.5 py-2 font-mono text-xs text-white/75 focus:outline-hidden focus:border-[#c8a84e66]" %>
          </div>
          <%= f.submit t("contracts.index.filter"), class: "w-full sm:w-auto bg-[#c8a84e22] text-[#c8a84e] border border-[#c8a84e44] px-3 py-2 rounded font-mono text-xs font-semibold tracking-[1px] hover:bg-[#c8a84e33] transition-colors cursor-pointer" %>
        <% end %>
      </div>

      <% if @entity_exposure_rows.empty? %>
            <div class="font-mono text-xs text-white/35 py-2">
              <%= t("dashboard.entity_exposure.empty") %>
            </div>
          <% else %>
            <div class="overflow-x-auto">
              <div class="min-w-[600px]">
                <div class="grid grid-cols-[160px_1fr_160px_120px] gap-3 font-mono text-[10px] tracking-[2px] text-white/35 border-b border-white/8 pb-2">
                  <span><%= t("dashboard.entity_exposure.col_flag") %></span>
                  <span><%= t("dashboard.entity_exposure.col_entity") %></span>
                  <span class="text-right"><%= t("dashboard.entity_exposure.col_value") %></span>
                  <span class="text-right"><%= t("dashboard.entity_exposure.col_count") %></span>
                </div>
                <div class="divide-y divide-white/5">
                  <% @entity_exposure_rows.each do |row| %>
                    <%= link_to entity_path(row[:entity_id]), class: "grid grid-cols-[160px_1fr_160px_120px] gap-3 py-2.5 font-mono text-xs hover:bg-white/[0.02] transition-colors rounded", data: { turbo_frame: "_top" } do %>
                      <span class="text-[#c8a84e]"><%= flag_type_label(row[:flag_type]) %></span>
                      <span class="text-white/75 truncate"><%= row[:entity_name] %></span>
                      <span class="text-right text-white/65"><%= number_to_currency(row[:exposure_value], unit: "€", delimiter: ",", separator: ".", format: "%u%n", precision: 2) %></span>
                      <span class="text-right text-[#e8e0d4]"><%= number_with_delimiter(row[:exposure_count]) %></span>
                    <% end %>
                  <% end %>
                </div>
              </div>
            </div>

            <%# Entity table pagination %>
            <% if @entity_total_pages > 1 %>
              <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3 mt-4 pt-3 border-t border-white/5 font-mono text-[10px] text-white/35">
                <span><%= t("dashboard.entity_exposure.pagination.info", page: @entity_page, total_pages: @entity_total_pages, total: number_with_delimiter(@entity_total)) %></span>
                <div class="flex gap-2">
                  <% if @entity_page > 1 %>
                    <%= link_to t("dashboard.entity_exposure.pagination.prev"),
                          dashboard_index_path(entity_page: @entity_page - 1, entity_sort: @entity_sort, entity_flag_type: @entity_flag_type, severity: @severity_filter),
                          class: "border border-white/10 px-2.5 py-1 rounded hover:border-[#c8a84e44] hover:text-[#c8a84e] transition-all",
                          data: { turbo_frame: "entity-table" } %>
                  <% end %>
                  <% if @entity_page < @entity_total_pages %>
                    <%= link_to t("dashboard.entity_exposure.pagination.next"),
                          dashboard_index_path(entity_page: @entity_page + 1, entity_sort: @entity_sort, entity_flag_type: @entity_flag_type, severity: @severity_filter),
                          class: "border border-white/10 px-2.5 py-1 rounded hover:border-[#c8a84e44] hover:text-[#c8a84e] transition-all",
                          data: { turbo_frame: "entity-table" } %>
                  <% end %>
                </div>
              </div>
            <% end %>
          <% end %>
        </div>
      </turbo-frame>

  </div>

  <%# Crossings Pane %>
  <div data-dashboard-target="pane" data-pane="cruzamentos" class="hidden">
    <h2 class="font-['Space_Grotesk'] text-xl font-semibold mb-2 text-[#e8e0d4]"><%= t("dashboard.crossings.heading") %></h2>
    <p class="text-white/40 text-sm mb-6"><%= t("dashboard.crossings.subheading") %></p>
    <div class="border border-white/8 rounded-lg overflow-hidden">
      <div class="grid grid-cols-[1fr_120px] bg-white/3 p-3 px-5 border-b border-white/8 font-mono text-[11px] tracking-widest text-white/40">
        <span><%= t("dashboard.crossings.col_crossing") %></span>
        <span class="text-right"><%= t("dashboard.crossings.col_count") %></span>
      </div>
      <% @crossings.each do |row| %>
        <div class="grid grid-cols-[1fr_120px] p-3.5 px-5 border-b border-white/4 last:border-0 font-mono text-sm">
          <span class="text-white/60"><%= row[:label] %></span>
          <span class="text-[#c8a84e] font-bold text-right"><%= row[:count] %></span>
        </div>
      <% end %>
    </div>
  </div>

  <%# Sources Pane %>
  <div data-dashboard-target="pane" data-pane="fontes" class="hidden">
    <h2 class="font-['Space_Grotesk'] text-xl font-semibold mb-2"><%= t("dashboard.sources.heading") %></h2>
    <p class="text-white/40 text-sm mb-6"><%= t("dashboard.sources.subheading") %></p>
    <div class="grid grid-cols-1 sm:grid-cols-2 gap-2">
      <% @sources.each do |source| %>
        <% dot_color = source[:status] == "active" ? "bg-[#44ff88] shadow-[0_0_6px_rgba(68,255,136,0.4)]" :
                       source[:status] == "error"  ? "bg-[#ff4444] shadow-[0_0_6px_rgba(255,68,68,0.4)]"  :
                                                     "bg-white/20" %>
        <div class="p-4 px-5 border border-white/6 rounded-lg bg-white/2">
          <div class="flex flex-wrap justify-between items-center gap-2 mb-1.5">
            <div>
              <span class="font-bold text-sm text-[#e8e0d4]"><%= source[:name] %></span>
              <span class="font-mono text-[10px] text-white/25 ml-2"><%= source[:country] %></span>
            </div>
            <div class="flex items-center gap-1.5">
              <div class="w-1.5 h-1.5 rounded-full <%= dot_color %>"></div>
              <span class="font-mono text-[10px] text-white/35 uppercase"><%= t("data_sources.status.#{source[:status]}", default: source[:status].to_s) %></span>
            </div>
          </div>
          <div class="flex justify-between font-mono">
            <span class="text-[11px] text-white/35"><%= t("data_sources.types.#{source[:type]}", default: source[:type].to_s.capitalize) %></span>
            <span class="text-xs text-[#c8a84e]"><%= t("dashboard.sources.records", count: source[:records]) %></span>
          </div>
          <% if source[:synced_at] %>
            <div class="font-mono text-[10px] text-white/20 mt-1"><%= t("dashboard.sources.synced", date: source[:synced_at]) %></div>
          <% end %>
        </div>
      <% end %>
    </div>
  </div>

  <%# Methodology Pane %>
  <div data-dashboard-target="pane" data-pane="metodologia" class="hidden">
    <div class="max-w-3xl">
      <h2 class="font-['Space_Grotesk'] text-xl font-semibold mb-1 text-[#e8e0d4]"><%= t("dashboard.methodology.heading") %></h2>
      <p class="text-white/40 text-sm mb-8"><%= t("dashboard.methodology.subheading") %></p>

      <%# Approach %>
      <div class="mb-8 border border-white/8 rounded-lg p-6">
        <div class="font-mono text-[10px] tracking-[3px] text-[#c8a84e] mb-3"><%= t("dashboard.methodology.approach_label") %></div>
        <p class="text-white/65 text-sm leading-relaxed mb-3">
          <%= t("dashboard.methodology.approach_p1") %>
        </p>
        <p class="text-white/65 text-sm leading-relaxed">
          <%= t("dashboard.methodology.approach_p2") %>
        </p>
      </div>

      <%# Track A %>
      <div class="mb-6">
        <div class="font-mono text-[10px] tracking-[3px] text-[#ff4444] mb-3"><%= t("dashboard.methodology.track_a") %></div>
        <div class="space-y-2">
          <%# A1 — active, expanded %>
          <% a1_key = "A1_REPEAT_DIRECT_AWARD"
             a1_sev  = @flag_type_severities[a1_key] || "high"
             a1_sty  = severity_styles(a1_sev) %>
          <div class="bg-white/[0.02] border <%= a1_sty[:border] %> rounded-lg p-4">
            <div class="flex items-start gap-3 mb-3">
              <span class="font-mono text-[10px] font-bold text-[#ff4444] w-6 shrink-0 pt-0.5">A1</span>
              <div class="flex-1 min-w-0">
                <span class="font-mono text-xs font-semibold text-[#e8e0d4]"><%= t("dashboard.methodology.flags.a1_title") %></span>
                <span class="font-mono text-xs text-white/40 ml-2"><%= t("dashboard.methodology.flags.a1_desc") %></span>
              </div>
              <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border shrink-0 <%= a1_sty[:bg] %> <%= a1_sty[:text] %> <%= a1_sty[:border] %>"><%= t("contracts.show.flags.severity_#{a1_sev}") %></span>
            </div>
            <div class="ml-9 space-y-2">
              <p class="font-mono text-[11px] text-white/55 leading-relaxed"><%= t("dashboard.methodology.flags.a1_detail") %></p>
              <p class="font-mono text-[11px] text-white/35 leading-relaxed"><%= t("dashboard.methodology.flags.a1_how") %></p>
            </div>
          </div>
          <%# A2 — active, expanded %>
          <% a2_key = "A2_PUBLICATION_AFTER_CELEBRATION"
             a2_sev  = @flag_type_severities[a2_key] || "medium"
             a2_sty  = severity_styles(a2_sev) %>
          <div class="bg-white/[0.02] border <%= a2_sty[:border] %> rounded-lg p-4">
            <div class="flex items-start gap-3 mb-3">
              <span class="font-mono text-[10px] font-bold text-[#ff4444] w-6 shrink-0 pt-0.5">A2</span>
              <div class="flex-1 min-w-0">
                <span class="font-mono text-xs font-semibold text-[#e8e0d4]"><%= t("dashboard.methodology.flags.a2_title") %></span>
                <span class="font-mono text-xs text-white/40 ml-2"><%= t("dashboard.methodology.flags.a2_desc") %></span>
              </div>
              <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border shrink-0 <%= a2_sty[:bg] %> <%= a2_sty[:text] %> <%= a2_sty[:border] %>"><%= t("contracts.show.flags.severity_#{a2_sev}") %></span>
            </div>
            <div class="ml-9 space-y-2">
              <p class="font-mono text-[11px] text-white/55 leading-relaxed"><%= t("dashboard.methodology.flags.a2_detail") %></p>
              <p class="font-mono text-[11px] text-white/35 leading-relaxed"><%= t("dashboard.methodology.flags.a2_how") %></p>
            </div>
          </div>
          <%# A3, A4 — compact, not yet active %>
          <% [
            ["A3", t("dashboard.methodology.flags.a3_title"), t("dashboard.methodology.flags.a3_desc"), "high"],
            ["A4", t("dashboard.methodology.flags.a4_title"), t("dashboard.methodology.flags.a4_desc"), "medium"],
          ].each do |code, title, desc, sev| %>
            <% sty = severity_styles(sev) %>
            <div class="flex items-center gap-3 bg-white/[0.02] border border-white/[0.06] rounded-lg p-3.5">
              <span class="font-mono text-[10px] font-bold text-[#ff4444] w-6 shrink-0"><%= code %></span>
              <div class="flex-1 min-w-0">
                <span class="font-mono text-xs font-semibold text-[#e8e0d4]"><%= title %></span>
                <span class="font-mono text-xs text-white/40 ml-2"><%= desc %></span>
              </div>
              <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border shrink-0 <%= sty[:bg] %> <%= sty[:text] %> <%= sty[:border] %>"><%= t("contracts.show.flags.severity_#{sev}") %></span>
            </div>
          <% end %>
          <%# A5 — active, expanded %>
          <% a5_key = "A5_THRESHOLD_SPLITTING"
             a5_sev  = @flag_type_severities[a5_key] || "medium"
             a5_sty  = severity_styles(a5_sev) %>
          <div class="bg-white/[0.02] border <%= a5_sty[:border] %> rounded-lg p-4">
            <div class="flex items-start gap-3 mb-3">
              <span class="font-mono text-[10px] font-bold text-[#ff4444] w-6 shrink-0 pt-0.5">A5</span>
              <div class="flex-1 min-w-0">
                <span class="font-mono text-xs font-semibold text-[#e8e0d4]"><%= t("dashboard.methodology.flags.a5_title") %></span>
                <span class="font-mono text-xs text-white/40 ml-2"><%= t("dashboard.methodology.flags.a5_desc") %></span>
              </div>
              <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border shrink-0 <%= a5_sty[:bg] %> <%= a5_sty[:text] %> <%= a5_sty[:border] %>"><%= t("contracts.show.flags.severity_#{a5_sev}") %></span>
            </div>
            <div class="ml-9 space-y-2">
              <p class="font-mono text-[11px] text-white/55 leading-relaxed"><%= t("dashboard.methodology.flags.a5_detail") %></p>
              <p class="font-mono text-[11px] text-white/35 leading-relaxed"><%= t("dashboard.methodology.flags.a5_how") %></p>
            </div>
          </div>
          <%# A6 — compact %>
          <% a6_sty = severity_styles("medium") %>
          <div class="flex items-center gap-3 bg-white/[0.02] border border-white/[0.06] rounded-lg p-3.5">
            <span class="font-mono text-[10px] font-bold text-[#ff4444] w-6 shrink-0">A6</span>
            <div class="flex-1 min-w-0">
              <span class="font-mono text-xs font-semibold text-[#e8e0d4]"><%= t("dashboard.methodology.flags.a6_title") %></span>
              <span class="font-mono text-xs text-white/40 ml-2"><%= t("dashboard.methodology.flags.a6_desc") %></span>
            </div>
            <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border shrink-0 <%= a6_sty[:bg] %> <%= a6_sty[:text] %> <%= a6_sty[:border] %>"><%= t("contracts.show.flags.severity_medium") %></span>
          </div>
          <%# A7 — active, expanded %>
          <% a7_key = "A7_ABNORMAL_DIRECT_AWARD_RATE"
             a7_sev  = @flag_type_severities[a7_key] || "medium"
             a7_sty  = severity_styles(a7_sev) %>
          <div class="bg-white/[0.02] border <%= a7_sty[:border] %> rounded-lg p-4">
            <div class="flex items-start gap-3 mb-3">
              <span class="font-mono text-[10px] font-bold text-[#ff4444] w-6 shrink-0 pt-0.5">A7</span>
              <div class="flex-1 min-w-0">
                <span class="font-mono text-xs font-semibold text-[#e8e0d4]"><%= t("dashboard.methodology.flags.a7_title") %></span>
                <span class="font-mono text-xs text-white/40 ml-2"><%= t("dashboard.methodology.flags.a7_desc") %></span>
              </div>
              <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border shrink-0 <%= a7_sty[:bg] %> <%= a7_sty[:text] %> <%= a7_sty[:border] %>"><%= t("contracts.show.flags.severity_#{a7_sev}") %></span>
            </div>
            <div class="ml-9 space-y-2">
              <p class="font-mono text-[11px] text-white/55 leading-relaxed"><%= t("dashboard.methodology.flags.a7_detail") %></p>
              <p class="font-mono text-[11px] text-white/35 leading-relaxed"><%= t("dashboard.methodology.flags.a7_how") %></p>
            </div>
          </div>
          <%# A8 — compact %>
          <% a8_sty = severity_styles("low") %>
          <div class="flex items-center gap-3 bg-white/[0.02] border border-white/[0.06] rounded-lg p-3.5">
            <span class="font-mono text-[10px] font-bold text-[#ff4444] w-6 shrink-0">A8</span>
            <div class="flex-1 min-w-0">
              <span class="font-mono text-xs font-semibold text-[#e8e0d4]"><%= t("dashboard.methodology.flags.a8_title") %></span>
              <span class="font-mono text-xs text-white/40 ml-2"><%= t("dashboard.methodology.flags.a8_desc") %></span>
            </div>
            <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border shrink-0 <%= a8_sty[:bg] %> <%= a8_sty[:text] %> <%= a8_sty[:border] %>"><%= t("contracts.show.flags.severity_low") %></span>
          </div>
          <%# A9 — active, expanded %>
          <% a9_key = "A9_PRICE_ANOMALY"
             a9_sev  = @flag_type_severities[a9_key] || "medium"
             a9_sty  = severity_styles(a9_sev) %>
          <div class="bg-white/[0.02] border <%= a9_sty[:border] %> rounded-lg p-4">
            <div class="flex items-start gap-3 mb-3">
              <span class="font-mono text-[10px] font-bold text-[#ff4444] w-6 shrink-0 pt-0.5">A9</span>
              <div class="flex-1 min-w-0">
                <span class="font-mono text-xs font-semibold text-[#e8e0d4]"><%= t("dashboard.methodology.flags.a9_title") %></span>
                <span class="font-mono text-xs text-white/40 ml-2"><%= t("dashboard.methodology.flags.a9_desc") %></span>
              </div>
              <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border shrink-0 <%= a9_sty[:bg] %> <%= a9_sty[:text] %> <%= a9_sty[:border] %>"><%= t("contracts.show.flags.severity_#{a9_sev}") %></span>
            </div>
            <div class="ml-9 space-y-2">
              <p class="font-mono text-[11px] text-white/55 leading-relaxed"><%= t("dashboard.methodology.flags.a9_detail") %></p>
              <p class="font-mono text-[11px] text-white/35 leading-relaxed"><%= t("dashboard.methodology.flags.a9_how") %></p>
            </div>
          </div>
        </div>
      </div>

      <%# Track B %>
      <div class="mb-6">
        <div class="font-mono text-[10px] tracking-[3px] text-[#c8a84e] mb-3"><%= t("dashboard.methodology.track_b") %></div>
        <div class="space-y-2">
          <%# B5 is active — expanded card %>
          <% b5_sev = @flag_type_severities["B5_BENFORD_DEVIATION"] || "medium"
             b5_sty = severity_styles(b5_sev) %>
            <div class="bg-white/[0.02] border border-[#c8a84e33] rounded-lg p-4 mb-2">
              <div class="flex items-start gap-3 mb-3">
                <span class="font-mono text-[10px] font-bold text-[#c8a84e] w-6 shrink-0 pt-0.5">B5</span>
                <div class="flex-1 min-w-0">
                  <span class="font-mono text-xs font-semibold text-[#e8e0d4]"><%= t("dashboard.methodology.flags.b5_title") %></span>
                  <span class="font-mono text-xs text-white/40 ml-2"><%= t("dashboard.methodology.flags.b5_desc") %></span>
                </div>
                <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border shrink-0 <%= b5_sty[:bg] %> <%= b5_sty[:text] %> <%= b5_sty[:border] %>"><%= t("contracts.show.flags.severity_#{b5_sev}") %></span>
              </div>
              <div class="ml-9 space-y-2">
                <p class="font-mono text-[11px] text-white/55 leading-relaxed"><%= t("dashboard.methodology.flags.b5_detail") %></p>
                <p class="font-mono text-[11px] text-white/35 leading-relaxed"><%= t("dashboard.methodology.flags.b5_how") %></p>
              </div>
            </div>
          <%# B2 — active, expanded %>
          <% b2_key = "B2_SUPPLIER_CONCENTRATION"
             b2_sev  = @flag_type_severities[b2_key] || "high"
             b2_sty  = severity_styles(b2_sev) %>
          <div class="bg-white/[0.02] border border-[#c8a84e33] rounded-lg p-4">
            <div class="flex items-start gap-3 mb-3">
              <span class="font-mono text-[10px] font-bold text-[#c8a84e] w-6 shrink-0 pt-0.5">B2</span>
              <div class="flex-1 min-w-0">
                <span class="font-mono text-xs font-semibold text-[#e8e0d4]"><%= t("dashboard.methodology.flags.b2_title") %></span>
                <span class="font-mono text-xs text-white/40 ml-2"><%= t("dashboard.methodology.flags.b2_desc") %></span>
              </div>
              <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border shrink-0 <%= b2_sty[:bg] %> <%= b2_sty[:text] %> <%= b2_sty[:border] %>"><%= t("contracts.show.flags.severity_#{b2_sev}") %></span>
            </div>
            <div class="ml-9 space-y-2">
              <p class="font-mono text-[11px] text-white/55 leading-relaxed"><%= t("dashboard.methodology.flags.b2_detail") %></p>
              <p class="font-mono text-[11px] text-white/35 leading-relaxed"><%= t("dashboard.methodology.flags.b2_how") %></p>
            </div>
          </div>
          <%# B3 — active, expanded %>
          <% b3_key = "B3_PRICE_HIGH"
             b3_sev  = @flag_type_severities[b3_key] || "medium"
             b3_sty  = severity_styles(b3_sev) %>
          <div class="bg-white/[0.02] border border-[#c8a84e33] rounded-lg p-4">
            <div class="flex items-start gap-3 mb-3">
              <span class="font-mono text-[10px] font-bold text-[#c8a84e] w-6 shrink-0 pt-0.5">B3</span>
              <div class="flex-1 min-w-0">
                <span class="font-mono text-xs font-semibold text-[#e8e0d4]"><%= t("dashboard.methodology.flags.b3_title") %></span>
                <span class="font-mono text-xs text-white/40 ml-2"><%= t("dashboard.methodology.flags.b3_desc") %></span>
              </div>
              <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border shrink-0 <%= b3_sty[:bg] %> <%= b3_sty[:text] %> <%= b3_sty[:border] %>"><%= t("contracts.show.flags.severity_#{b3_sev}") %></span>
            </div>
            <div class="ml-9 space-y-2">
              <p class="font-mono text-[11px] text-white/55 leading-relaxed"><%= t("dashboard.methodology.flags.b3_detail") %></p>
              <p class="font-mono text-[11px] text-white/35 leading-relaxed"><%= t("dashboard.methodology.flags.b3_how") %></p>
            </div>
          </div>
          <%# B1, B4 pending sufficient data volume %>
          <% [
            ["B1", t("dashboard.methodology.flags.b1_title"), t("dashboard.methodology.flags.b1_desc"), "high"],
            ["B4", t("dashboard.methodology.flags.b4_title"), t("dashboard.methodology.flags.b4_desc"), "medium"]
          ].each do |code, title, desc, sev| %>
            <% sty = severity_styles(sev) %>
            <div class="flex items-center gap-3 bg-white/[0.02] border border-white/[0.06] rounded-lg p-3.5 opacity-60">
              <span class="font-mono text-[10px] font-bold text-[#c8a84e] w-6 shrink-0"><%= code %></span>
              <div class="flex-1 min-w-0">
                <span class="font-mono text-xs font-semibold text-[#e8e0d4]"><%= title %></span>
                <span class="font-mono text-xs text-white/40 ml-2"><%= desc %></span>
              </div>
              <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border shrink-0 <%= sty[:bg] %> <%= sty[:text] %> <%= sty[:border] %>"><%= t("contracts.show.flags.severity_#{sev}") %></span>
            </div>
          <% end %>
        </div>
        <p class="font-mono text-[10px] text-white/25 mt-2 ml-1"><%= t("dashboard.methodology.track_b_note") %></p>
      </div>

      <%# Track C %>
      <div class="mb-6">
        <div class="font-mono text-[10px] tracking-[3px] text-[#e8e0d4] mb-3"><%= t("dashboard.methodology.track_c") %></div>
        <div class="space-y-2">
          <% [
            ["C1", t("dashboard.methodology.flags.c1_title"), t("dashboard.methodology.flags.c1_desc"), "medium"],
            ["C2", t("dashboard.methodology.flags.c2_title"), t("dashboard.methodology.flags.c2_desc"), "medium"],
            ["C3", t("dashboard.methodology.flags.c3_title"), t("dashboard.methodology.flags.c3_desc"), "low"],
            ["C4", t("dashboard.methodology.flags.c4_title"), t("dashboard.methodology.flags.c4_desc"), "high"],
            ["C5", t("dashboard.methodology.flags.c5_title"), t("dashboard.methodology.flags.c5_desc"), "low"],
            ["C7", t("dashboard.methodology.flags.c7_title"), t("dashboard.methodology.flags.c7_desc"), "high"]
          ].each do |code, title, desc, sev| %>
            <% sty = severity_styles(sev) %>
            <div class="flex items-center gap-3 bg-white/[0.02] border border-white/[0.06] rounded-lg p-3.5">
              <span class="font-mono text-[10px] font-bold text-[#e8e0d4] w-6 shrink-0"><%= code %></span>
              <div class="flex-1 min-w-0">
                <span class="font-mono text-xs font-semibold text-[#e8e0d4]"><%= title %></span>
                <span class="font-mono text-xs text-white/40 ml-2"><%= desc %></span>
              </div>
              <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border shrink-0 <%= sty[:bg] %> <%= sty[:text] %> <%= sty[:border] %>"><%= t("contracts.show.flags.severity_#{sev}") %></span>
            </div>
          <% end %>
        </div>
      </div>

      <%# Risk Scoring Algorithm %>
      <div class="mb-8 bg-white/[0.02] border border-white/[0.06] rounded-lg p-5">
        <div class="font-mono text-[10px] tracking-[3px] text-white/40 mb-3"><%= t("dashboard.methodology.risk_scoring.heading") %></div>
        <p class="font-mono text-[11px] text-white/50 mb-4"><%= t("dashboard.methodology.risk_scoring.intro") %></p>
        <div class="space-y-1.5">
          <div class="flex items-center gap-3">
            <span class="font-mono text-[10px] text-white/25 w-24 shrink-0"><%= t("dashboard.methodology.risk_scoring.range_none") %></span>
            <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border text-white/30 bg-white/[0.04] border-white/10"><%= t("dashboard.methodology.risk_scoring.tier_none") %></span>
          </div>
          <div class="flex items-center gap-3">
            <span class="font-mono text-[10px] text-white/25 w-24 shrink-0"><%= t("dashboard.methodology.risk_scoring.range_low") %></span>
            <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border text-[#c8a84e] bg-[#c8a84e12] border-[#c8a84e33]"><%= t("dashboard.methodology.risk_scoring.tier_low") %></span>
          </div>
          <div class="flex items-center gap-3">
            <span class="font-mono text-[10px] text-white/25 w-24 shrink-0"><%= t("dashboard.methodology.risk_scoring.range_medium") %></span>
            <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border text-[#ff8844] bg-[#ff884412] border-[#ff884433]"><%= t("dashboard.methodology.risk_scoring.tier_medium") %></span>
          </div>
          <div class="flex items-center gap-3">
            <span class="font-mono text-[10px] text-white/25 w-24 shrink-0"><%= t("dashboard.methodology.risk_scoring.range_high") %></span>
            <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border text-[#ff4444] bg-[#ff444412] border-[#ff444433]"><%= t("dashboard.methodology.risk_scoring.tier_high") %></span>
          </div>
          <div class="flex items-center gap-3">
            <span class="font-mono text-[10px] text-white/25 w-24 shrink-0"><%= t("dashboard.methodology.risk_scoring.range_critical") %></span>
            <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border text-[#cc1111] bg-[#cc111112] border-[#cc111133]"><%= t("dashboard.methodology.risk_scoring.tier_critical") %></span>
          </div>
        </div>
        <p class="font-mono text-[10px] text-white/25 mt-4 leading-relaxed"><%= t("dashboard.methodology.risk_scoring.degradation") %></p>
        <div class="mt-5 pt-4 border-t border-white/[0.06]">
          <div class="font-mono text-[10px] tracking-[2px] text-white/30 mb-3"><%= t("dashboard.methodology.risk_scoring.flag_scores_heading") %></div>
          <div class="space-y-1">
            <% [
              ["A1", "A1_REPEAT_DIRECT_AWARD",               50, "high"],
              ["A2", "A2_PUBLICATION_AFTER_CELEBRATION",      40, "medium"],
              ["A5", "A5_THRESHOLD_SPLITTING",                35, "medium"],
              ["A7", "A7_ABNORMAL_DIRECT_AWARD_RATE",         35, "medium"],
              ["A9", "A9_PRICE_ANOMALY (ratio 1.5–2.0)",      30, "medium"],
              ["A9", "A9_PRICE_ANOMALY (ratio ≥ 2.0)",        55, "high"],
              ["A9", "A9_PRICE_REDUCTION (ratio < 0.5)",      10, "low"],
              ["B2", "B2_SUPPLIER_CONCENTRATION",             45, "high"],
              ["B3", "B3_PRICE_HIGH / B3_PRICE_LOW (|z|≥2.5)", 25, "medium"],
              ["B3", "B3_PRICE_HIGH / B3_PRICE_LOW (|z|≥3.5)", 45, "high"],
              ["B5", "B5_BENFORD_DEVIATION (medium)",         35, "medium"],
              ["B5", "B5_BENFORD_DEVIATION (high)",           55, "high"],
              ["C1", "C1_MISSING_CPV_CODE",                   25, "medium"],
              ["C3", "C3_SHORT_CONTRACT_DURATION",            20, "low"],
              ["C7", "C7_POTENTIAL_CONFLICT_OF_INTEREST",      65, "high"],
            ].each do |track, flag, score, sev| %>
              <% row_sty = severity_styles(sev) %>
              <div class="flex items-center gap-2">
                <span class="font-mono text-[9px] font-bold text-white/30 w-4 shrink-0"><%= track %></span>
                <span class="font-mono text-[9px] text-white/40 flex-1"><%= flag %></span>
                <span class="font-mono text-[9px] font-bold px-1.5 py-0.5 rounded border shrink-0 <%= row_sty[:bg] %> <%= row_sty[:text] %> <%= row_sty[:border] %>"><%= score %></span>
              </div>
            <% end %>
          </div>
        </div>
      </div>

      <%# Sources %>
      <div class="border-t border-white/8 pt-6">
        <div class="font-mono text-[10px] tracking-[3px] text-white/40 mb-4"><%= t("dashboard.methodology.primary_refs") %></div>
        <div class="space-y-3">
          <% [
            [
              "OECD/LEGAL/0396",
              "Recommendation of the Council on Fighting Bid Rigging in Public Procurement (2012, rev. 2023)",
              "https://legalinstruments.oecd.org/en/instruments/OECD-LEGAL-0396"
            ],
            [
              "OECD (2025)",
              "OECD Guidelines for Fighting Bid Rigging in Public Procurement — 2025 Update",
              "https://doi.org/10.1787/cbe05a56-en"
            ],
            [
              "OECD/LEGAL/0411",
              "Recommendation of the Council on Public Procurement",
              "https://legalinstruments.oecd.org/en/instruments/OECD-LEGAL-0411"
            ],
            [
              "OCDS v1.2",
              "Open Contracting Data Standard — field definitions and risk indicators",
              "https://standard.open-contracting.org/"
            ],
            [
              "IMPIC / dados.gov.pt",
              "Contratos Públicos — Portal Base (2012–2026), updated daily",
              "https://dados.gov.pt/datasets/66d72d488ca4b7cb2de28712"
            ]
          ].each do |ref, title, url| %>
            <div class="flex items-start gap-3">
              <span class="font-mono text-[10px] text-[#c8a84e] w-32 shrink-0 pt-0.5"><%= ref %></span>
              <%= link_to title, url, target: "_blank", rel: "noopener noreferrer",
                    class: "font-mono text-xs text-white/55 hover:text-white/80 transition-colors" %>
            </div>
          <% end %>
        </div>
      </div>

      <%# Disclaimer %>
      <div class="mt-8 bg-[#c8a84e08] border border-[#c8a84e22] rounded-lg p-4">
        <p class="font-mono text-[11px] text-white/40 leading-relaxed">
          <%= t("dashboard.methodology.disclaimer") %>
        </p>
      </div>
    </div>
  </div>

  <%# Footer %>
  <footer class="py-10 border-t border-white/4 mt-12 text-center space-y-1">
    <div class="font-mono text-[10px] tracking-[2px] text-white/20">
      <%= t("app.name") %>
    </div>
    <div class="font-mono text-[10px] text-white/15">
      <%= link_to t("app.footer_repo"), "https://github.com/bit-of-a-shambles/open-tender-watch",
          target: "_blank", rel: "noopener noreferrer",
          class: "hover:text-white/35 transition-colors" %>
    </div>
  </footer>
</div>
